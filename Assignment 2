
<!DOCTYPE html>
<html>
<head>
    <title>HTML Workshop</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="bg-dark text-white p-5">
    <div class="container">
        <span class="badge bg-warning text-dark">Free Class</span>
        <h1 class="mt-3">web design  Workshop</h1>
        <p> webpage using HTML aBuild your first responsive webpage with HTML and Bootstrap.</p>
    </div>
</div>

<div class="container mt-5">
    <div class="row">

        <div class="col-md-5">
            <div class="card p-4">
                <h3>Workshop Information</h3>

                <p><b>Day</b><br>Saturday</p>
                <p><b>Place</b><br>Computer Lab</p>
                <p><b>Bring</b><br>Laptop and charger</p>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card p-4">

                <h3>Registration</h3>

                <form>
                    <label class="form-label">Your name</label>
                    <input type="text" class="form-control mb-3">

                    <label class="form-label">Your email</label>
                    <input type="email" class="form-control mb-3">

                    <b>Select time</b>

                    <div class="form-check">
                        <input type="radio" name="time" class="form-check-input">
                        <label class="form-check-label">Morning 9:00 - 11:00</label>
                    </div>

                    <div class="form-check">
                        <input type="radio" name="time" class="form-check-input">
                        <label class="form-check-label">Afternoon 2:00 - 4:00</label>
                    </div>

                    <button class="btn btn-primary mt-3">Submit</button>
                </form>

                <small class="text-muted mt-3">This is a practice form.</small>

            </div>
        </div>

    </div>
</div>
<script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
